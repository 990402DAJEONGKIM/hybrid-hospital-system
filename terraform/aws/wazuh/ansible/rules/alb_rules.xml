 rules · XML
<!-- =========================================================
     alb_rules.xml
     AWS ALB 액세스 로그 탐지 룰
 
     룰 ID 범위: 100870~100879
     수집 경로: S3 wodle → aws-k2p-alb-01 버킷
 
     ISMS-P 2.9.1 로그 관리
     추가 260616 김강환
     ========================================================= -->
 
<group name="alb,aws,">
 
  <!-- ALB 액세스 로그 베이스 룰 -->
  <rule id="100870" level="0">
    <decoded_as>json</decoded_as>
    <location>Wazuh-AWS</location>
    <field name="aws.source">alb</field>
    <description>ALB 액세스 로그</description>
    <group>alb,aws,</group>
  </rule>
 
  <!-- ELB 헬스체크 억제 — 정상 동작 노이즈 제거 -->
  <rule id="100871" level="0">
    <if_sid>100870</if_sid>
    <field name="aws.user_agent">ELB-HealthChecker</field>
    <description>ALB 헬스체크 — 무시</description>
    <group>noise,</group>
  </rule>
 
  <!-- 5xx 단건 — level 0 (대시보드 비노출, 폭증 카운터 역할) -->
  <rule id="100872" level="0">
    <if_sid>100870</if_sid>
    <field name="aws.elb_status_code">^5</field>
    <description>ALB 5xx 단건 — 무시</description>
    <group>alb,error,</group>
  </rule>
 
  <!-- 5xx 폭증 — 5분 내 50회 이상 → Slack -->
  <rule id="100873" level="12" frequency="50" timeframe="300">
    <if_matched_sid>100872</if_matched_sid>
    <description>ALB 5xx 폭증 — 서비스 장애 의심 (5분 내 50회 이상)</description>
    <group>alb,error,availability,</group>
    <mitre><id>T1499</id></mitre>
  </rule>
 
  <!-- 동일 IP 대량 요청 — 1분 내 500회 이상 → Slack -->
  <rule id="100874" level="12" frequency="500" timeframe="60">
    <if_matched_sid>100870</if_matched_sid>
    <same_field>aws.client_ip</same_field>
    <description>ALB DDoS 의심 — 동일 IP 대량 요청 (1분 내 500회 이상) IP: $(aws.client_ip)</description>
    <group>alb,ddos,attack,</group>
    <mitre><id>T1499</id></mitre>
  </rule>
 
  <!-- ALB 헬스체크 WAF 403 억제 — 정상 동작 노이즈 제거 추가 260617 김강환 -->
  <rule id="100875" level="0">
    <if_sid>80328</if_sid>
    <field name="aws.user_agent" type="pcre2">ELB-HealthChecker</field>
    <description>ALB 헬스체크 WAF 403 억제</description>
    <group>noise,</group>
  </rule>
 
</group>