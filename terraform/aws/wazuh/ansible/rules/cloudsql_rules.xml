<group name="cloudsql,audit,gcp,">


    <!-- 수정 260618 김강환: patient_id_hash 조건 제거 -->
    <!-- cloudsql 로그 식별: decoded_as json + action_type만으로 -->
    <!-- onprem db_audit과 구분은 100650이 audit_log_id로 먼저 잡음 -->
    <rule id="100199" level="0">
        <decoded_as>json</decoded_as>
        <field name="action_type">^LOGIN$|^LOGOUT$|^ADMIN_|^UNKNOWN$</field>
        <field name="audit_log_id" negate="yes">\.+</field>
        <description>Cloud SQL 감사 로그 수신 — 베이스</description>
        <group>cloudsql,</group>
    </rule>
    <!-- Cloud SQL DB 접속 탐지 (ISMS-P 2.9.1) -->
    <!-- 수정 260611 김강환: decoded_as 단독 → if_sid>100199 -->
    <rule id="100200" level="3">
        <if_sid>100199</if_sid>
        <field name="action_type">^LOGIN$</field>
        <description>Cloud SQL DB 접속 — source_ip: $(source_ip)</description>
        <group>cloudsql,login,</group>
    </rule>

    <!-- Cloud SQL DB 접속 종료 -->
    <!-- 수정 260611 김강환: decoded_as 단독 → if_sid>100199 -->
    <rule id="100201" level="3">
        <if_sid>100199</if_sid>
        <field name="action_type">^LOGOUT$</field>
        <description>Cloud SQL DB 접속 종료 — source_ip: $(source_ip)</description>
        <group>cloudsql,logout,</group>
    </rule>

    <!-- Cloud SQL 관리자 작업 -->
    <!-- 수정 260611 김강환: decoded_as 단독 → if_sid>100199 -->
    <rule id="100202" level="8">
        <if_sid>100199</if_sid>
        <field name="action_type">^ADMIN_</field>
        <description>Cloud SQL 관리자 작업 탐지 — action: $(action_type)</description>
        <group>cloudsql,admin,</group>
    </rule>

    <!-- 수정 260618 김강환: 정상 접속 대역 정의 후 외부 IP 탐지 -->
    <rule id="100203" level="12">
        <if_sid>100200</if_sid>
        <field name="source_ip" negate="yes">^127\.|^10\.10\.1\.|^172\.29\.|^10\.0\.</field>
        <description>Cloud SQL 외부 IP 접속 탐지 — source_ip: $(source_ip)</description>
        <group>cloudsql,login,suspicious,</group>
    </rule>

    <rule id="100204" level="0">
        <if_sid>100200</if_sid>
        <field name="source_ip">^127\.0\.0\.1$</field>
        <description>Cloud SQL 내부 복제 연결 — 무시</description>
        <group>cloudsql,noise,</group>
    </rule>

    <rule id="100205" level="0">
        <if_sid>100201</if_sid>
        <field name="source_ip">^127\.0\.0\.1$</field>
        <description>Cloud SQL 내부 복제 종료 — 무시</description>
        <group>cloudsql,noise,</group>
    </rule>

    <!-- gcp-rds-proxy-01 내부 복제 연결 — 무시 -->
    <rule id="100206" level="0">
        <if_sid>100200</if_sid>
        <field name="source_ip">^10\.10\.1\.</field>
        <description>GCP 내부 서브넷 연결 — 무시</description>
        <group>cloudsql,noise,</group>
    </rule>

    <!-- GCP 내부 서브넷 접속 종료 무시 - 260609 김강환 -->
    <rule id="100207" level="0">
        <if_sid>100201</if_sid>
        <field name="source_ip">^10\.10\.1\.</field>
        <description>GCP 내부 서브넷 접속 종료 — 무시</description>
        <group>cloudsql,noise,</group>
    </rule>

    <!-- 자동 백업 무시 - 260609 김강환 -->
    <rule id="100208" level="0">
        <if_sid>100202</if_sid>
        <match>ADMIN_AUTOMATEDBACKU</match>
        <description>Cloud SQL 자동 백업 — 무시</description>
        <group>cloudsql,noise,</group>
    </rule>


    <!-- Cloud SQL PSA 내부 헬스체크 억제 추가 260618 김강환 -->
    <rule id="100209" level="0">
      <if_sid>100200</if_sid>
      <field name="source_ip">^172\.29\.</field>
      <description>Cloud SQL PSA 내부 연결 — 무시</description>
      <group>cloudsql,noise,</group>
    </rule>

    <rule id="100210" level="0">
      <if_sid>100201</if_sid>
      <field name="source_ip">^172\.29\.</field>
      <description>Cloud SQL PSA 내부 연결 종료 — 무시</description>
      <group>cloudsql,noise,</group>
    </rule>

</group>