<!-- =========================================================
     lambda_rules.xml
     AWS Lambda 실행 로그 탐지 룰

     룰 ID 범위: 100830~100849
     수정 260618 김강환: 디코더 기반으로 룰 재설계
       [ERROR] → apache-errorlog(30101)
       Task timed out → 디코더 없음(1002)

     수집 경로: CloudWatch Logs → Wazuh wodle aws-s3 (5분마다)

     ISMS-P 2.9.1 로그 관리
     ========================================================= -->

<group name="lambda,aws,">

  <!-- Lambda [ERROR] 탐지 → Slack 수정 260618 김강환 -->
  <rule id="100830" level="12">
    <if_sid>30101</if_sid>
    <description>Lambda 실행 실패 탐지 — [ERROR]</description>
    <group>lambda,error,aws,</group>
  </rule>
  <!-- Lambda 타임아웃 탐지 → Slack 수정 260618 김강환 -->
  <rule id="100831" level="12">
    <decoded_as>lambda-timeout</decoded_as>
    <description>Lambda 타임아웃</description>
    <group>lambda,timeout,aws,</group>
  </rule>

  <!-- Bedrock InvokeModel 실패 → 대시보드만 수정 260618 김강환 -->
  <!-- Vault OIDC public_keys 로테이션 — 무시 (added/deleted만) -->
  <rule id="100084" level="0">
    <if_sid>553,554</if_sid>
    <field name="file" type="pcre2">vault-data/logical/.+/oidc_tokens/public_keys/</field>
    <description>Vault OIDC 공개키 로테이션 — 무시</description>
    <group>noise,</group>
  </rule>

</group>