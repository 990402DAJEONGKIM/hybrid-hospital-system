#local_rules.xml
<group name="local,sudo,after_hours,fim,">

<!-- ##################### 개발 단계의 룰임 ##########################-->
<!-- SSH 브루트포스 Slack 알림 억제 - 개발 단계 임시 - 260610 김강환 -->
<!-- SSH 관련 룰 전부 억제 - 추가 260612 김강환 -->
<!-- 온프레미스 SSH 포트 차단 예정, ECS는 Security Group으로 제어 -->
  <rule id="5762" level="0" overwrite="yes">
    <if_sid>5700</if_sid>
    <description>SSH connection reset 억제</description>
  </rule>
  <rule id="5501" level="0" overwrite="yes">
    <if_sid>5500</if_sid>
    <description>PAM Login session opened 억제</description>
  </rule>
  <rule id="5502" level="0" overwrite="yes">
    <if_sid>5500</if_sid>
    <description>PAM Login session closed 억제</description>
  </rule>
  <rule id="5551" level="0" overwrite="yes">
    <if_sid>5550</if_sid>
    <description>다중 로그인 실패 억제</description>
  </rule>
  <rule id="5763" level="0" overwrite="yes">
    <if_sid>5700</if_sid>
    <description>SSH 브루트포스 억제</description>
  </rule>
  <rule id="5712" level="0" overwrite="yes">
    <if_sid>5700</if_sid>
    <description>SSH 존재하지 않는 계정 억제</description>
  </rule>
  <rule id="5715" level="0" overwrite="yes">
    <if_sid>5700</if_sid>
    <description>SSH 로그인 성공 억제</description>
  </rule>

  <!-- 온프레미스 SSH 억제 — 나중에 SSH/인터넷 차단 예정 추가 260618 김강환 -->
  <rule id="5710" level="0" overwrite="yes">
    <if_sid>5700</if_sid>
    <description>SSH 존재하지 않는 계정 — 억제</description>
    <group>noise,</group>
  </rule>

  <rule id="5760" level="0" overwrite="yes">
    <if_sid>5700</if_sid>
    <description>SSH 인증 실패 — 억제</description>
    <group>noise,</group>
  </rule>

  <rule id="5503" level="0" overwrite="yes">
    <if_sid>5500</if_sid>
    <description>PAM 로그인 실패 — 억제</description>
    <group>noise,</group>
  </rule>


  <!-- ───────────────────────────────────── -->
  <!-- sudo 사용 탐지 -->
  <!-- ───────────────────────────────────── -->

  <!-- 기본 sudo 실행 -->
  <!-- sudo 명령어 실행 탐지 - 수정 260611 김강환 -->
  <!-- if_sid>5400 + dstuser=root로 직접 탐지 -->
  <!-- 개발 단계 나중에 12로 올릴 예정 -->
  <rule id="100001" level="8">
    <if_sid>5400</if_sid>
    <match>USER=root</match>
    <description>sudo root 권한 전환 — 사용자: $(srcuser) 실행 명령: $(command)</description>
    <group>sudo_usage,privilege_escalation</group>
  </rule>

  <!-- root 권한 획득 -->
  <!-- dstuser는 static field라 안됨 → match로 변경 -->
  <rule id="100003" level="12">
    <if_sid>5402</if_sid>
    <match>USER=root</match>
    <description>root 권한 전환 탐지 - 사용자: $(srcuser)</description>
    <group>sudo_usage,root_access,privilege_escalation</group>
  </rule>

  <!-- ───────────────────────────────────── -->
  <!-- 파일 권한 변경 -->
  <!-- if_group>syscheck 대신 if_sid 사용, field name 대신 match 사용 -->
  <!-- ───────────────────────────────────── -->

  <rule id="100004" level="0">
    <if_sid>550</if_sid>
    <field name="changed_fields">^permission$</field>
    <description>파일 권한 변경 탐지</description>
    <group>fim,permission_change</group>
  </rule>

  <!-- ───────────────────────────────────── -->
  <!-- 중요 시스템 파일 변조 -->
  <!-- ───────────────────────────────────── -->

  <rule id="100005" level="12">
    <if_sid>550,554,553</if_sid>
    <field name="file">/etc/passwd</field>
    <description>중요 파일 변조 탐지 - /etc/passwd</description>
    <group>fim,critical_file</group>
  </rule>

  <rule id="100006" level="12">
    <if_sid>550,554,553</if_sid>
    <field name="file">/etc/shadow</field>
    <description>중요 파일 변조 탐지 - /etc/shadow</description>
    <group>fim,critical_file</group>
  </rule>

  <rule id="100007" level="12">
    <if_sid>550,554,553</if_sid>
    <field name="file">/etc/sudoers$</field>
    <description>sudoers 파일 변경 탐지 - 권한 상승 의심</description>
    <group>fim,privilege_escalation</group>
  </rule>

  <!-- sudoers.d persistence -->
  <rule id="100019" level="12">
    <if_sid>550,554,553</if_sid>
    <field name="file">/etc/sudoers.d/</field>
    <description>sudoers.d 파일 변경 탐지 - persistence 의심</description>
    <group>fim,privilege_escalation,persistence</group>
  </rule>

  <!-- SSH 설정 변경 -->
  <rule id="100008" level="12">
    <if_sid>550,554,553</if_sid>
    <field name="file">/etc/ssh/sshd_config</field>
    <description>SSH 설정 변경 탐지</description>
    <group>fim,ssh</group>
  </rule>

</group>

<group name="web,nginx,attack,bruteforce,persistence,">

  <!-- ───────────────────────────────────── -->
  <!-- 웹쉘 업로드 탐지 -->
  <!-- if_sid 554 = 파일 추가, field name event 대신 if_sid로 구분 -->
  <!-- ───────────────────────────────────── -->

  <rule id="100010" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i)^/var/www/.*\.(php|phtml|phar|sh|py|pl)$</field>
    <description>웹 서버 경로에 실행 파일 생성됨 (웹쉘 의심)</description>
    <group>web_attack,fim,webshell</group>
  </rule>

  <rule id="100022" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i)^/usr/share/nginx/.*\.(php|phtml|phar|sh|py|pl)$</field>
    <description>nginx 경로에 실행 파일 생성됨 (웹쉘 의심)</description>
    <group>web_attack,fim,webshell</group>
  </rule>

  <!-- ───────────────────────────────────── -->
  <!-- Nginx Recon -->
  <!-- ───────────────────────────────────── -->

  <rule id="100011" level="10" frequency="20" timeframe="60">
    <if_matched_sid>31101</if_matched_sid>
    <match>404</match>
    <description>1분 내 20회 이상 404 발생 - 웹 스캔 의심</description>
    <group>web_scan,reconnaissance</group>
  </rule>

  <!-- ───────────────────────────────────── -->
  <!-- SQL Injection -->
  <!-- ───────────────────────────────────── -->

  <rule id="100012" level="12">
    <if_sid>31106</if_sid>
    <match>union select|select from|insert into|drop table|or 1=1</match>
    <description>SQL Injection 공격 패턴 탐지</description>
    <group>web_attack,sql_injection</group>
  </rule>


  <!-- ───────────────────────────────────── -->
  <!-- 중요 실행 파일 변조 -->
  <!-- if_sid 550 = 파일 수정 -->
  <!-- ───────────────────────────────────── -->

  <rule id="100014" level="9">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^/usr/bin/</field>
    <description>시스템 실행 파일 변조 탐지 (/usr/bin) - 백도어 의심</description>
    <group>fim,rootkit,persistence</group>
  </rule>

  <rule id="100015" level="12">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">\/authorized_keys$</field>
    <description>SSH authorized_keys 수정 탐지 - 파일: $(file)</description>
    <group>fim,ssh_attack,persistence</group>
  </rule>

  <!-- ───────────────────────────────────── -->
  <!-- SSH Persistence -->
  <!-- ───────────────────────────────────── -->

  <rule id="100016" level="9">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^/usr/sbin/</field>
    <description>관리자 실행 파일 변조 탐지 (/usr/sbin) - 백도어 의심</description>
    <group>fim,rootkit,persistence</group>
  </rule>



  <!-- ───────────────────────────────────── -->
  <!-- 신규 계정 생성 -->
  <!-- ───────────────────────────────────── -->

  <!-- 신규 계정 생성 — 계정명/UID/GID/홈/셸 전부 표시 -->
  <!-- 5901(그룹생성)은 100018에 정보 포함되므로 대시보드 노출 불필요 → level 0 -->
  <rule id="100018" level="12" overwrite="yes">
    <if_sid>5902</if_sid>
    <description>새로운 사용자 계정 생성 탐지 — $(full_log)</description>
    <group>account_management,privilege_escalation,persistence,</group>
  </rule>


  <rule id="5901" level="0" overwrite="yes">
    <if_sid>5900</if_sid>
    <match>new group:</match>
    <description>신규 그룹 생성 — 100018에 정보 포함, 대시보드 비노출</description>
    <group>noise,</group>
  </rule>

  <!-- 553/554 일반 파일 추가/삭제 한글화 -->
  <rule id="554" level="5" overwrite="yes">
    <category>ossec</category>
    <decoded_as>syscheck_new_entry</decoded_as>
    <description>파일 추가 탐지 — 경로: $(file)</description>
    <group>ossec,syscheck,syscheck_entry_added,syscheck_file,</group>
  </rule>
  <rule id="553" level="7" overwrite="yes">
    <category>ossec</category>
    <decoded_as>syscheck_deleted</decoded_as>
    <description>파일 삭제 탐지 — 경로: $(file)</description>
    <group>ossec,syscheck,syscheck_entry_deleted,syscheck_file,</group>
  </rule>

  <!-- ───────────────────────────────────── -->
  <!-- systemd persistence -->
  <!-- ───────────────────────────────────── -->

  <rule id="100020" level="13">
    <if_sid>554,550</if_sid>
    <match>/etc/systemd/system/</match>
    <description>systemd 서비스 파일 변경 탐지 (/etc) - persistence 의심</description>
    <group>fim,persistence,systemd</group>
  </rule>

  <rule id="100021" level="9">
    <if_sid>554,550</if_sid>
    <match>/usr/lib/systemd/system/</match>
    <description>systemd 서비스 파일 변경 탐지 (/usr/lib) - 패키지 변경 가능성 있음</description>
    <group>fim,systemd</group>
  </rule>

  <!-- ───────────────────────────────────── -->
  <!-- cron persistence -->
  <!-- ───────────────────────────────────── -->

  <rule id="100023" level="12">
    <if_sid>550,554</if_sid>
    <match>/etc/crontab</match>
    <description>crontab 파일 변경 탐지 - persistence 의심</description>
    <group>fim,persistence,cron</group>
  </rule>

  <rule id="100024" level="12">
    <if_sid>550,554</if_sid>
    <match>/etc/cron.d/</match>
    <description>cron.d 파일 변경 탐지 - persistence 의심</description>
    <group>fim,persistence,cron</group>
  </rule>

  <rule id="100025" level="12">
    <if_sid>550,554</if_sid>
    <match>/etc/cron.</match>
    <description>cron 주기 디렉토리 파일 변경 탐지 - persistence 의심</description>
    <group>fim,persistence,cron</group>
  </rule>

  <!-- ───────────────────────────────────── -->
  <!-- /usr/local/bin persistence -->
  <!-- ───────────────────────────────────── -->

  <rule id="100026" level="10">
    <if_sid>550,554</if_sid>
    <match>/usr/local/bin/</match>
    <description>시스템 실행 파일 변조 탐지 (/usr/local/bin) - 백도어 의심</description>
    <group>fim,rootkit,persistence</group>
  </rule>

  <!-- ───────────────────────────────────── -->
  <!-- rc.local persistence -->
  <!-- ───────────────────────────────────── -->

  <rule id="100027" level="12">
    <if_sid>550,554</if_sid>
    <match>/etc/rc.local</match>
    <description>rc.local 변경 탐지 - persistence 의심</description>
    <group>fim,persistence</group>
  </rule>

  <!-- if_sid 554 = 파일 추가 -->
  <rule id="100028" level="12">
    <if_sid>554</if_sid>
    <match>/usr/bin/</match>
    <description>시스템 경로에 신규 실행 파일 생성 탐지 (/usr/bin) - 백도어 의심</description>
    <group>fim,rootkit,persistence</group>
  </rule>

  <rule id="100029" level="12">
    <if_sid>554</if_sid>
    <match>/usr/sbin/</match>
    <description>관리자 경로에 신규 실행 파일 생성 탐지 (/usr/sbin) - 백도어 의심</description>
    <group>fim,rootkit,persistence</group>
  </rule>

  <rule id="100037" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">\/\.ssh\/</field>
    <description>SSH .ssh 디렉토리 신규 파일 생성 탐지 - 파일: $(file)</description>
    <group>fim,ssh_attack,persistence</group>
  </rule>

  <rule id="100038" level="12">
    <if_sid>553</if_sid>
    <field name="file" type="pcre2">\/\.ssh\/</field>
    <description>SSH .ssh 디렉토리 파일 삭제 탐지 - 파일: $(file)</description>
    <group>fim,ssh_attack,persistence</group>
  </rule>


  <!-- NTP 동기화 실패 탐지 -->
  <rule id="100040" level="7">
    <if_sid>1002</if_sid>
    <match>No network connectivity</match>
    <program_name>systemd-timesyncd</program_name>
    <description>NTP 시간 동기화 실패 — $(hostname)</description>
    <group>ntp,availability</group>
  </rule>


  <!-- .claude 작업 디렉토리 FIM 노이즈 억제 -->
  <rule id="100065" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">/\.claude/</field>
    <description>Claude 작업 디렉토리 변경 — 무시</description>
    <group>noise,</group>
  </rule>

  <!-- 계정관리 명령 표준 잠금파일 억제 - 추가 260622 -->
  <rule id="100073" level="0">
    <if_sid>553,554</if_sid>
    <field name="file" type="pcre2">/etc/(group|gshadow|passwd|shadow)\.lock$</field>
    <description>계정관리 명령 표준 잠금파일 — 무시</description>
    <group>noise,</group>
  </rule>

  <!-- ldconfig 캐시 갱신 억제 - 추가 260622 -->
  <rule id="100078" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">/etc/ld.so.cache</field>
    <description>ldconfig 캐시 갱신 — 무시</description>
    <group>noise,</group>
  </rule>

  <!-- 모니터링 에이전트(Alloy/Vector) 설정 배포 노이즈 억제 - 추가 260622 -->
  <rule id="100080" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">/etc/alloy/|/etc/sysconfig/alloy|/etc/vector/|/etc/default/vector</field>
    <description>모니터링 에이전트(Alloy/Vector) 설정 배포 — 무시</description>
    <group>noise,</group>
  </rule>

  <!-- Vault Agent 동적 시크릿 갱신 노이즈 억제 - 추가 260622 -->
  <rule id="100081" level="0">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">vault-agent/secrets/</field>
    <description>Vault Agent 동적 시크릿 갱신 — 무시</description>
    <group>noise,</group>
  </rule>

  <!-- /etc/alternatives 심볼릭 링크 노이즈 억제 - 패키지 설치/업데이트 시 update-alternatives가 자동 갱신 -->
  <rule id="100082" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">/etc/alternatives/</field>
    <description>update-alternatives 자동 갱신(패키지 설치/업데이트) — 무시</description>
    <group>noise,</group>
  </rule>

  <rule id="100121" level="0">
    <if_sid>5503</if_sid>
    <match>ssm-user</match>
    <description>SSM Agent PAM 실패 — 노이즈 제거</description>
  </rule>


</group>

<group name="indexer,availability,">

  <!-- ───────────────────────────────────── -->
  <!-- Filebeat → Indexer 연결 실패 탐지 -->
  <!-- ───────────────────────────────────── -->

  <rule id="100030" level="12">
    <if_sid>1002</if_sid>
    <match>filebeat</match>
    <regex>connection refused|no such host|i/o timeout</regex>
    <description>Filebeat → Indexer 연결 실패 탐지</description>
    <group>indexer,availability</group>
  </rule>


  <!-- ───────────────────────────────────────── -->
  <!-- GuardDuty HIGH — EventBridge가 Slack 담당 -->
  <!-- Wazuh는 대시보드 기록용만 (중복 알람 방지) -->
  <!-- ───────────────────────────────────────── -->
  <rule id="100500" level="7" overwrite="yes">
    <if_sid>80303</if_sid>
    <description>AWS GuardDuty HIGH — 대시보드 기록용 (Slack은 EventBridge 담당)</description>
    <group>guardduty,aws,</group>
  </rule>

  <rule id="100501" level="7" overwrite="yes">
    <if_sid>80307</if_sid>
    <description>AWS GuardDuty HIGH 포트스캔 — 대시보드 기록용 (Slack은 EventBridge 담당)</description>
    <group>guardduty,aws,</group>
  </rule>




  <!-- 경로 제한 제거: FIM 감시 대상(/etc, /home/mspadmin) 전체에서 -->
  <!-- 60초 내 100회 이상 파일 추가 = 대량 암호화 패턴으로 판단 -->
  <!-- 대량 파일 암호화 — 랜섬웨어 핵심 패턴 - 수정 260616 김강환 -->
  <rule id="100508" level="15" frequency="100" timeframe="60" ignore="300">
    <if_matched_sid>550</if_matched_sid>
    <description>랜섬웨어 의심 — 대량 파일 암호화/변조 탐지</description>
    <group>ransomware,malware,critical,</group>
    <mitre><id>T1486</id></mitre>
  </rule>

  <!-- /tmp, /dev/shm 실행파일 생성 — 드롭퍼 의심 -->
  <rule id="100509" level="14">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">\.sh$</field>
    <description>쉘스크립트 파일 생성 — 드로퍼 의심: $(file)</description>
    <group>ransomware,malware,persistence</group>
    <mitre><id>T1059</id></mitre>
  </rule>

  <!-- DDoS: VPC Flow 동일 출발지 대량 패킷 -->
  <rule id="100510" level="12" frequency="500" timeframe="60">
    <if_matched_sid>80501</if_matched_sid>
    <same_source_ip />
    <description>DDoS 의심 — 동일 출발지 대량 패킷</description>
    <group>ddos,network,attack</group>
    <mitre><id>T1499</id></mitre>
  </rule>

  <!-- DDoS: WAF BLOCK 폭증 -->
  <!-- 수정 260611 김강환: 100401 → 100400 (parent 룰 참조로 변경) -->
  <rule id="100511" level="13" frequency="50" timeframe="60">
    <if_matched_sid>100400</if_matched_sid>
    <description>DDoS 의심 — WAF 차단 이벤트 폭증</description>
    <group>ddos,waf,attack</group>
    <mitre><id>T1499</id></mitre>
  </rule>

  <!-- SQL Injection — nginx 로그 패턴 -->
  <rule id="100504" level="12">
    <if_sid>31103</if_sid>
    <match>union.*select|select.*from|insert.*into|drop.*table|--</match>
    <description>SQL Injection 시도 탐지</description>
    <group>web_attack,sql_injection,attack</group>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- 디렉토리 traversal -->
  <rule id="100505" level="12">
    <if_sid>31103</if_sid>
    <match>\.\./|\.\.\\|%2e%2e</match>
    <description>디렉토리 탐색 공격 탐지</description>
    <group>web_attack,attack</group>
    <mitre><id>T1083</id></mitre>
  </rule>

  <!-- 웹 스캐너 탐지 -->
  <rule id="100506" level="10">
    <if_sid>31103</if_sid>
    <match>nikto|sqlmap|nmap|masscan|dirbuster</match>
    <description>웹 취약점 스캐너 탐지</description>
    <group>web_attack,recon,attack</group>
    <mitre><id>T1595</id></mitre>
  </rule>




  <!-- 비정상 HTTP 메서드 -->
  <rule id="100513" level="10">
    <if_sid>31103</if_sid>
    <match>^TRACE |^TRACK |^DEBUG |^CONNECT </match>
    <description>비정상 HTTP 메서드 탐지</description>
    <group>web_attack,attack</group>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- VPC Flow ACCEPT 노이즈 제거 — 정상 트래픽은 대시보드 불필요 -->
  <rule id="100512" level="0" overwrite="yes">
    <if_sid>80401</if_sid>
    <description>VPC Flow ACCEPT — 노이즈 제거</description>
    <group>noise</group>
  </rule>

  <!-- filebeat 로그 2502 노이즈 억제 - 260611 김강환 -->
  <!-- /var/log/filebeat/filebeat 로그가 2502로 잡히는 오탐 제거 -->
  <rule id="100514" level="0">
    <if_sid>2502</if_sid>
    <location>/var/log/filebeat/filebeat</location>
    <description>filebeat 로그 2502 오탐 억제</description>
    <group>noise</group>
  </rule>


  <!-- 실행권한 부여 탐지 — 드로퍼 의심 추가 260618 김강환 -->
  <rule id="100515" level="14">
    <if_sid>553</if_sid>
    <field name="syscheck.perm_after" type="pcre2">x</field>
    <description>파일 실행권한 부여 탐지 — 드로퍼 의심: $(file)</description>
    <group>ransomware,malware,persistence</group>
    <mitre><id>T1059</id></mitre>
  </rule>




  <!-- 대량 파일 삭제 — 랜섬웨어 원본삭제 패턴 - 추가 260616 김강환 -->
  <rule id="100516" level="15" frequency="100" timeframe="60">
    <if_matched_sid>553</if_matched_sid>
    <description>대량 파일 삭제 탐지</description>
    <group>ransomware,malware,critical,</group>
    <mitre><id>T1486</id></mitre>
  </rule>


  <!-- 대량 확장자 변경 — 랜섬웨어 패턴 추가 260619 김강환 -->
  <rule id="100518" level="15" frequency="100" timeframe="60">
    <if_matched_sid>554</if_matched_sid>
    <field name="file" type="pcre2">\.l0ck3d$</field>
    <description>랜섬웨어 의심 — 대량 파일 확장자 변경 탐지 (.l0ck3d)</description>
    <group>ransomware,malware,critical,</group>
    <mitre><id>T1486</id></mitre>
  </rule>




  <!-- CRON PAM 세션 억제 - 추가 260611 김강환 -->
  <!-- cron 정기 작업 PAM 세션 열림/닫힘 — 정상 동작 노이즈 -->
  <rule id="100539" level="0">
    <if_sid>5501,5502</if_sid>
    <match>cron</match>
    <description>CRON PAM 세션 — 무시</description>
    <group>noise</group>
  </rule>

  <!-- sudo PAM 세션 열림/닫힘 억제 - 추가 260611 김강환 -->
  <!-- 100001로 이미 sudo root 전환 탐지하므로 중복 제거 -->
  <rule id="100540" level="0">
    <if_sid>5501,5502</if_sid>
    <match>sudo</match>
    <description>sudo PAM 세션 — 무시 (100001로 탐지)</description>
    <group>noise</group>
  </rule>


  <!-- ar.conf FIM mtime 변경 억제 - 추가 260611 김강환 -->
  <!-- Wazuh 매니저 restart 시 mtime만 갱신되는 정상 동작 -->
  <rule id="100541" level="0">
    <if_sid>550</if_sid>
    <field name="file">/var/ossec/etc/shared/ar.conf</field>
    <description>Wazuh ar.conf mtime 변경 — 무시</description>
    <group>noise</group>
  </rule>

  <!-- rsyslogd action suspended/resumed 억제 - 수정 260612 김강환 -->
  <rule id="100543" level="0">
    <if_sid>2502</if_sid>
    <program_name>rsyslogd</program_name>
    <description>rsyslogd action suspended/resumed — 무시</description>
    <group>noise</group>
  </rule>

  <!-- SSM Inventory 자동 호출 억제 - 추가 260613 김강환 -->
  <rule id="100548" level="0">
    <if_sid>80202</if_sid>
    <field name="aws.userIdentity.sessionContext.sessionIssuer.userName">AWSServiceRoleForAmazonSSM</field>
    <description>SSM Inventory 정상 동작 — 무시</description>
    <group>noise</group>
  </rule>

  <!-- GCP OS Login 캐시 파일 갱신 억제 - 수정 260622: modified 추가 -->
  <rule id="100549" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file">/etc/oslogin_passwd.cache</field>
    <description>GCP OS Login 캐시 파일 정상 갱신 — 무시</description>
    <group>noise</group>
  </rule>


  <!-- AWS ALB WAF 차단 한글 표시 - 추가 260612 김강환 -->
  <rule id="80328" level="0" overwrite="yes">
    <if_sid>80325</if_sid>
    <field name="aws.elb_status_code">403</field>
    <options>no_full_log</options>
    <description>AWS ALB WAF 차단 — 출발지: $(aws.client_ip) User-Agent: $(aws.user_agent)</description>
    <group>aws_alb,</group>
  </rule>

  <!-- ECS 자동 NIC/ALB/Snapshot 작업 억제 — 정상 인프라 동작 추가 260618 김강환 -->
  <rule id="80210" level="0">
    <if_sid>80202</if_sid>
    <field name="aws.eventName" type="pcre2">^AttachNetworkInterface$|^DetachNetworkInterface$|^CreateNetworkInterface$|^DeleteNetworkInterface$|^RegisterTargets$|^DeregisterTargets$|^DeleteSnapshot$</field>
    <description>ECS 자동 인프라 작업 — 억제</description>
    <group>noise,</group>
  </rule>

  <!-- DLM 자동 스냅샷 태그 억제 — 정상 AWS 자동화 추가 260618 김강환 -->
  <rule id="80211" level="0">
    <if_sid>80202</if_sid>
    <field name="aws.userAgent">dlm.amazonaws.com</field>
    <description>DLM 자동 스냅샷 태그 — 억제</description>
    <group>noise,</group>
  </rule>

  <!-- ECS AutoScaling 자동 종료/정지 — 정상 인프라 동작 억제 추가 260622 김강환 -->
  <rule id="80212" level="0">
    <if_sid>80202</if_sid>
    <field name="aws.userIdentity.sessionContext.sessionIssuer.userName">AWSServiceRoleForAutoScaling</field>
    <description>ECS AutoScaling 자동 인스턴스 종료/정지 — 억제</description>
    <group>noise,</group>
  </rule>


  <!-- AWS 콘솔 로그인 성공 억제 — CloudTrail에서 보존됨 추가 260618 김강환 -->
  <rule id="80253" level="0" overwrite="yes">
    <if_sid>80202</if_sid>
    <field name="aws.eventName">ConsoleLogin</field>
    <description>AWS 콘솔 로그인 성공 — 억제 (CloudTrail 보존)</description>
    <group>noise,</group>
  </rule>

  <!-- AWS GuardDuty 탐지 룰 한글 overwrite - 추가 260613 김강환 -->
  <!-- GuardDuty는 EventBridge → Slack 즉각 대응, Wazuh는 대시보드 기록용 -->
  <rule id="80301" level="3" overwrite="yes">
    <if_sid>80300</if_sid>
    <field name="aws.severity">0|1|2|3</field>
    <description>GuardDuty 낮은 위험 — 유형: $(aws.type) 설명: $(aws.description)</description>
    <group>aws,guardduty,</group>
  </rule>

  <rule id="80302" level="6" overwrite="yes">
    <if_sid>80300</if_sid>
    <field name="aws.severity">4|5|6</field>
    <description>GuardDuty 중간 위험 — 유형: $(aws.type) 설명: $(aws.description)</description>
    <group>aws,guardduty,</group>
  </rule>

  <rule id="80303" level="8" overwrite="yes">
    <if_sid>80300</if_sid>
    <field name="aws.severity">7|8|9</field>
    <description>GuardDuty 높은 위험 — 유형: $(aws.type) 설명: $(aws.description)</description>
    <group>aws,guardduty,</group>
  </rule>

  <rule id="80305" level="3" overwrite="yes">
    <if_sid>80301</if_sid>
    <field name="aws.service.action.actionType">PORT_PROBE</field>
    <description>GuardDuty 낮은 위험 포트 스캔 — IP: $(aws.service.action.portProbeAction.portProbeDetails.remoteIpDetails.ipAddressV4) 포트: $(aws.service.action.portProbeAction.portProbeDetails.localPortDetails.port) 유형: $(aws.type)</description>
    <group>aws,guardduty,</group>
  </rule>

  <rule id="80306" level="6" overwrite="yes">
    <if_sid>80302</if_sid>
    <field name="aws.service.action.actionType">PORT_PROBE</field>
    <description>GuardDuty 중간 위험 포트 스캔 — IP: $(aws.service.action.portProbeAction.portProbeDetails.remoteIpDetails.ipAddressV4) 포트: $(aws.service.action.portProbeAction.portProbeDetails.localPortDetails.port) 유형: $(aws.type)</description>
    <group>aws,guardduty,</group>
  </rule>

  <rule id="80307" level="8" overwrite="yes">
    <if_sid>80303</if_sid>
    <field name="aws.service.action.actionType">PORT_PROBE</field>
    <description>GuardDuty 높은 위험 포트 스캔 — IP: $(aws.service.action.portProbeAction.portProbeDetails.remoteIpDetails.ipAddressV4) 포트: $(aws.service.action.portProbeAction.portProbeDetails.localPortDetails.port) 유형: $(aws.type)</description>
    <group>aws,guardduty,</group>
  </rule>

  <!-- AWS ALB 에러 한글 표시 - 추가 260613 김강환 -->
  <rule id="80326" level="3" overwrite="yes">
    <if_sid>80325</if_sid>
    <field name="aws.elb_status_code">500</field>
    <options>no_full_log</options>
    <description>AWS ALB 500 서버 에러 — 출발지: $(aws.client_ip) 요청: $(aws.request)</description>
    <group>aws_alb,</group>
  </rule>

  <rule id="80327" level="3" overwrite="yes">
    <if_sid>80325</if_sid>
    <field name="aws.elb_status_code">503</field>
    <options>no_full_log</options>
    <description>AWS ALB 503 서비스 불가 — 출발지: $(aws.client_ip) 요청: $(aws.request)</description>
    <group>aws_alb,</group>
  </rule>



  <!-- FIM 파일 변조 상세 표시 수정 260619 김강환 -->
  <rule id="550" level="12" overwrite="yes">
    <category>ossec</category>
    <decoded_as>syscheck_integrity_changed</decoded_as>
    <description>파일 무결성 변조 감지 — 경로: $(file) 변경 항목: $(changed_fields)</description>
    <group>ossec,syscheck,syscheck_entry_modified,syscheck_file,</group>
  </rule>



<!-- Wazuh 서버 시작 한글 표시 - 추가 260612 김강환 -->
  <rule id="502" level="3" overwrite="yes">
    <if_sid>500</if_sid>
    <match>Manager started</match>
    <description>Wazuh 매니저 시작</description>
    <group>pci_dss_10.6.1,gpg13_10.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>


  <!-- 로그 파일 rotate 억제 수정 260618 김강환 — 조건 추가 -->
  <rule id="591" level="0" overwrite="yes">
    <if_sid>500</if_sid>
    <match>^ossec: File rotated</match>
    <description>로그 파일 rotate — 억제</description>
    <group>noise,</group>
  </rule>

  <!-- 취약점 탐지 Slack 억제 — 일일 보고서로 대체 - 추가 260617 김강환 -->
  <rule id="100066" level="0" overwrite="yes">
    <if_sid>23506</if_sid>
    <description>취약점 탐지 — Slack 억제 (일일 보고서로 대체)</description>
    <group>noise,</group>
  </rule>


</group>