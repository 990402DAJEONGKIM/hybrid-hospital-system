<!-- =========================================================
     monitoring_rules.xml
     모니터링 서버 전용 탐지 룰
     대상: Grafana, Prometheus, Nginx(Keycloak)

     룰 ID 범위:
       100800~100809  Grafana 탐지
       100810~100819  Prometheus 탐지
       100820~100829  Nginx(Keycloak) 탐지

     ISMS-P 관련 조항:
       2.9.1 로그관리
       2.11.1 사고 예방 및 대응
     추가 260612 김강환
     ========================================================= -->

<group name="monitoring,">

  <!-- =========================================================
       Grafana 탐지
       수집: journald grafana-server.service
       ========================================================= -->

  <!-- Grafana 로그인 실패 탐지 -->
  <rule id="100802" level="5">
    <if_sid>1002</if_sid>
    <program_name>grafana</program_name>
    <match>Failed to authenticate</match>
    <description>Grafana 인증 실패 — 사용자 토큰 오류 또는 로그인 실패</description>
    <group>monitoring,grafana,authentication_failed,</group>
  </rule>



  <!-- Grafana 브루트포스 탐지 — 2분 내 동일 IP 8회 인증 실패 -->
  <rule id="100804" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100802</if_matched_sid>
    <description>Grafana 브루트포스 의심 — 짧은 시간 내 반복 인증 실패</description>
    <group>monitoring,grafana,brute_force,</group>
    <mitre><id>T1110</id></mitre>
  </rule>


  <!-- =========================================================
       Nginx(Keycloak) 탐지
       수집: /var/log/nginx/access.log
       ========================================================= -->

  <!-- ELB 헬스체크 억제 -->
  <rule id="100820" level="0">
    <if_sid>31101,31103</if_sid>
    <match>ELB-HealthChecker</match>
    <description>ELB 헬스체크 — 무시</description>
    <group>noise</group>
  </rule>

  <!-- Nginx 400 에러 탐지 -->
  <rule id="100821" level="5">
    <if_sid>31101</if_sid>
    <description>모니터링 서버 Nginx 400 에러 — IP: $(srcip) URL: $(url)</description>
    <group>monitoring,nginx,web_error,</group>
  </rule>

  <!-- Nginx 브루트포스 탐지 — 2분 내 동일 IP 8회 400 에러 -->
  <rule id="100822" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100821</if_matched_sid>
    <same_source_ip/>
    <description>모니터링 서버 Nginx 브루트포스 의심 — 공격 IP: $(srcip)</description>
    <group>monitoring,nginx,brute_force,</group>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- /auth/refresh 401 억제 — 세션 만료 정상 흐름 추가 260618 김강환 -->
  <rule id="100823" level="0">
    <if_sid>100821</if_sid>
    <field name="data.url">/auth/refresh</field>
    <description>토큰 갱신 실패 — 정상 세션 만료 억제</description>
    <group>noise,</group>
  </rule>
  <!-- OIDC 토큰 교환 400 억제 — 인증코드 타이밍 이슈, 정상 흐름 추가 260622 김강환 -->
  <rule id="100824" level="0">
    <if_sid>100821</if_sid>
    <field name="data.url">/realms/mzclinic/protocol/openid-connect/token</field>
    <description>Keycloak OIDC 토큰 교환 400 — 인증코드 타이밍 이슈 억제</description>
    <group>noise,</group>
  </rule>


  <!-- =========================================================
       Keycloak 탐지
       수집: /var/log/keycloak-audit.log (Vector → Docker)
       ========================================================= -->

  <!-- Keycloak 정상동작 억제 - ISMS-P 2.9.1 - 추가 260615 김강환 -->
  <rule id="100850" level="0">
    <field name="container_name">keycloak</field>
    <field name="kc_type">REFRESH_TOKEN_ERROR|USER_INFO_REQUEST_ERROR</field>
    <description>Keycloak 정상 토큰 갱신 오류 억제</description>
  </rule>

  <!-- Keycloak 베이스룰 - ISMS-P 2.9.1 - 추가 260615 김강환 -->
  <rule id="100851" level="3">
    <field name="container_name">keycloak</field>
    <field name="kc_type">\.+</field>
    <description>Keycloak 감사 로그 — $(kc_type) IP: $(kc_ip)</description>
    <group>keycloak,audit,</group>
  </rule>

  <!-- Keycloak 로그인 실패 - ISMS-P 2.9.1 - 추가 260615 김강환 -->
  <rule id="100852" level="5">
    <if_sid>100851</if_sid>
    <field name="kc_type">LOGIN_ERROR</field>
    <description>Keycloak 로그인 실패 — IP: $(kc_ip)</description>
    <group>keycloak,authentication_failed,</group>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- Keycloak 브루트포스 - ISMS-P 2.9.1 - 추가 260615 김강환 -->
  <rule id="100853" level="12" frequency="5" timeframe="60" ignore="60">
    <if_matched_sid>100852</if_matched_sid>
    <same_field>kc_ip</same_field>
    <description>Keycloak 브루트포스 의심 — 공격 IP: $(kc_ip)</description>
    <group>keycloak,brute_force,</group>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- =========================================================
       OAuth2-Proxy 탐지
       수집: /var/log/oauth2-proxy-audit.log (Vector → Docker)
       ========================================================= -->

  <!-- ELB 헬스체크 억제 - ISMS-P 2.9.1 - 추가 260615 김강환 -->
  <rule id="100860" level="0">
    <field name="container_name">monitoring-portal-oauth2-proxy</field>
    <field name="message">ELB-HealthChecker</field>
    <description>OAuth2-Proxy ELB 헬스체크 억제</description>
  </rule>

  <!-- OAuth2-Proxy 인증 실패 카운터 — 단건 억제, 브루트포스 카운터 역할 수정 260618 김강환 -->
  <rule id="100861" level="0">
    <field name="container_name">monitoring-portal-oauth2-proxy</field>
    <field name="message">401</field>
    <description>OAuth2-Proxy 인증 실패 카운터</description>
    <group>oauth2_proxy,authentication_failed,</group>
  </rule>
  <!-- OAuth2-Proxy 브루트포스 - ISMS-P 2.9.1 - 추가 260615 김강환 -->
  <rule id="100862" level="12" frequency="8" timeframe="120" ignore="60">
    <if_matched_sid>100861</if_matched_sid>
    <description>OAuth2-Proxy 브루트포스 의심 — 반복 인증 실패</description>
    <group>oauth2_proxy,brute_force,</group>
    <mitre><id>T1110</id></mitre>
  </rule>




</group>