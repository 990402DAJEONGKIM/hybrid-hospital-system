<!-- =========================================================
     onprem_rules.xml
     온프레미스 서버(mspserver) 전용 탐지 룰

     룰 ID 범위:
       100031~100036  FIM — 중요 설정 파일 변조 탐지
       100058        USB 저장장치 연결 탐지
       100044         Vault 감사 로그 베이스 룰
       100045~100047  Vault 감사 로그 이상 탐지
       100048         UFW 차단 이벤트
       100049~100056  FIM 오탐 제거 (Vault 정상 동작, vim, psql)
       100057         CRON 노이즈 억제
       100600~100602  EMR FastAPI 감사 로그 탐지
       100650         DB 감사 로그 탐지
       100659~100660  Ollama EMR 배치 로그 탐지

     ISMS-P 관련 조항:
       2.5.1  접근통제
       2.6.1  네트워크 접근통제
       2.7.1  암호키 관리
       2.8.1  정보자산 접근통제
       2.9.1  로그관리 및 무결성
     ========================================================= -->

<!-- =========================================================
     FIM — 중요 설정 파일 변조 탐지
     감시 경로: /etc, /home/mspadmin (agent_onprem.conf syscheck)
     이벤트:
       550 = modified (체크섬 변경)
       553 = deleted  (파일 삭제)
       554 = added    (파일 추가)
     ========================================================= -->
<group name="onprem,fim,critical_file,">


  <!-- =========================================================
       USB 저장장치 연결 탐지
       내부자 위협 — 데이터 유출 수단 감지
       ISMS-P 2.8.1 정보자산 접근통제
       ========================================================= -->

  <!-- USB Mass Storage 연결 — 데이터 유출 의심 -->
  <!-- MITRE T1091 이동식 매체를 통한 복제 -->
  <!-- 수정 260611 김강환: 100044 → 100037 (Vault 베이스 룰 ID 확보) -->
  <rule id="100058" level="12">
    <if_sid>81100</if_sid>
    <match>USB Mass Storage</match>
    <description>온프레미스 USB 저장장치 연결 — 데이터 유출 의심</description>
    <group>onprem,usb,insider_threat</group>
    <mitre><id>T1091</id></mitre>
  </rule>

  <!-- =========================================================
       Vault 감사 로그 이상 탐지
       수집 경로: /home/mspadmin/hospital-db/vault-logs/audit.log
       Vault가 모든 API 요청을 JSON으로 기록
       ISMS-P 2.5.1 접근통제, 2.7.1 암호키 관리

       구조:
         100044 베이스 룰: Vault JSON 로그 식별
         100045~100047: if_sid>100044 child 룰
       ========================================================= -->

  <!-- Vault 감사 로그 베이스 룰 -->
  <!-- type 필드(request/response)로 Vault 로그 식별 -->
  <!-- 추가 260611 김강환 -->
  <rule id="100044" level="0">
    <decoded_as>json</decoded_as>
    <field name="type">^request$|^response$</field>
    <description>Vault 감사 로그 수신</description>
    <group>vault,onprem,</group>
  </rule>

  <!-- Vault root 토큰 사용 탐지 -->
  <!-- 운영 환경에서 root 토큰 사용은 비정상 — 즉시 확인 필요 -->
  <!-- MITRE T1078.004 클라우드 계정 탈취 -->
  <!-- 수정 260611 김강환: decoded_as 단독 → if_sid>100044 -->
  <rule id="100045" level="12">
    <if_sid>100044</if_sid>
    <field name="auth.display_name">^root$</field>
    <description>Vault root 토큰 사용 탐지 — 비정상 접근 의심</description>
    <group>vault,onprem,authentication_success</group>
    <mitre><id>T1078.004</id></mitre>
  </rule>

  <!-- Vault secret 삭제 탐지 -->
  <!-- secret/ 경로 데이터 삭제 — 데이터 파괴 또는 흔적 제거 의심 -->
  <!-- MITRE T1485 데이터 파괴 -->
  <!-- 수정 260611 김강환: decoded_as 단독 → if_sid>100044 -->
  <rule id="100046" level="12">
    <if_sid>100044</if_sid>
    <field name="request.operation">^delete$</field>
    <field name="request.path" type="pcre2">^secret/</field>
    <description>Vault secret 삭제 탐지</description>
    <group>vault,onprem,data_destruction</group>
    <mitre><id>T1485</id></mitre>
  </rule>

  <!-- Vault 감사 로그 비활성화 시도 탐지 -->
  <!-- sys/audit/file 삭제 = 감사 로그 끄기 시도 — 로그 회피 공격 -->
  <!-- MITRE T1562.008 감사 로그 비활성화 -->
  <!-- 수정 260611 김강환: decoded_as 단독 → if_sid>100044 -->
  <rule id="100047" level="13">
    <if_sid>100044</if_sid>
    <field name="request.operation">^delete$</field>
    <field name="request.path">^sys/audit/file$</field>
    <description>Vault 감사 로그 비활성화 시도 — 로그 회피</description>
    <group>vault,onprem,defense_evasion</group>
    <mitre><id>T1562.008</id></mitre>
  </rule>

  <!-- =========================================================
  UFW 방화벽 차단 이벤트
  /var/log/ufw.log에서 UFW BLOCK 패턴 탐지
  ISMS-P 2.6.1 네트워크 접근통제
  수정 260611 김강환: syslog → ufw.log로 수집 경로 변경
  ========================================================= -->
  <rule id="100048" level="8">
    <if_sid>4100,2502</if_sid>
    <match>UFW BLOCK</match>
    <description>UFW 차단 이벤트 — 출발지: $(srcip) 목적지: $(dstip)</description>
    <group>onprem,firewall,network</group>
  </rule>

  <!-- =========================================================
       FIM 오탐 제거 — Vault 정상 동작으로 인한 노이즈

       Vault는 정상 동작 중에 아래 경로에 파일을 생성/수정/삭제함.
       이는 보안 이벤트가 아니므로 level=0으로 무시 처리.

       단, 각 룰은 최소 범위만 무시하도록 event 타입을 구분함:
         - audit.log      : modified만 무시 (deleted/added는 탐지 유지)
         - core/_keyring  : modified만 무시 (deleted/added는 탐지 유지)
         - sys/token/     : added/deleted만 무시 (modified는 탐지 유지)
         - sys/expire/    : added/deleted만 무시 (modified 중 lease renew는 별도 처리)
       ========================================================= -->

  <!-- vault-logs/audit.log modified 무시 -->
  <!-- 이유: Vault API 요청마다 audit.log에 append → FIM이 매번 modified 감지 -->
  <!-- 삭제(553)/추가(554)는 탐지 유지 — 로그 삭제는 공격 징후(MITRE T1562.008) -->
  <rule id="100049" level="0">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">vault-logs/audit\.log$</field>
    <description>Vault audit.log 정상 append — 무시</description>
    <group>noise</group>
  </rule>

  <!-- vault-data/core/_master, _keyring modified 무시 -->
  <!-- 이유: Vault가 내부 암호화 키를 주기적으로 갱신 → modified 반복 발생 -->
  <!-- 삭제(553)/추가(554)는 탐지 유지 — 키 파일 삭제/교체는 이상 징후 -->
  <rule id="100050" level="0">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">vault-data/core/_(master|keyring)$</field>
    <description>Vault 내부 암호화 키 주기적 갱신 — 무시</description>
    <group>noise</group>
  </rule>

  <!-- vault-data/sys/expire/id/auth/approle/login/ added/deleted 무시 -->
  <!-- 이유: AppRole 로그인 시 lease 파일 생성, 만료 시 삭제 -->
  <!-- modified는 탐지 유지 -->
  <rule id="100054" level="0">
    <if_sid>553,554</if_sid>
    <field name="file" type="pcre2">vault-data/sys/expire/id/auth/approle/login/</field>
    <description>Vault AppRole 로그인 lease 정상 동작 — 무시</description>
    <group>noise</group>
  </rule>





  <!-- vault-data/sys/expire/token/ added/deleted/modified 무시 -->
  <!-- 수정 260622: modified(550)도 노이즈로 추가 — lease 갱신 빈도가 높아 -->
  <!-- 대시보드 노이즈가 됨. 토큰 비활성화(sys/audit/file 삭제 등)는 -->
  <!-- 100047이 별도로 잡고 있으므로 보안 공백 없음 -->
  <rule id="100052" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">vault-data/sys/expire/token/</field>
    <description>Vault 토큰 lease 생성/만료/갱신 정상 동작 — 무시</description>
    <group>noise</group>
  </rule>

  <!-- vault-data/sys/expire/id/database/creds/ added/deleted/modified 무시 -->
  <!-- 이유: DB 동적 자격증명(onprem-api-role, api-role) 발급/갱신/만료 시 파일 생성/수정/삭제 -->
  <!-- modified도 무시 — lease renew 시 파일 내용이 정상적으로 변경됨 -->
  <rule id="100053" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">vault-data/sys/expire/id/database/creds/</field>
    <description>Vault DB 동적 자격증명 발급/갱신/만료 정상 동작 — 무시</description>
    <group>noise</group>
  </rule>

  <!-- vault-data/sys/expire/id/auth/approle/login/ added/deleted 무시 -->
  <!-- 이유: AppRole 로그인 시 lease 파일 생성, 만료 시 삭제 -->
  <!-- modified는 탐지 유지 -->
  <rule id="100054" level="0">
    <if_sid>553,554</if_sid>
    <field name="file" type="pcre2">vault-data/sys/expire/id/auth/approle/login/</field>
    <description>Vault AppRole 로그인 lease 정상 동작 — 무시</description>
    <group>noise</group>
  </rule>

  <!-- vim swap 파일 added/modified/deleted 무시 -->
  <!-- 이유: vim으로 파일 편집 시 .swp 임시 파일 생성/삭제 -->
  <rule id="100055" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">\.swp$|\.swpx$</field>
    <description>vim swap 파일 정상 동작 — 무시</description>
    <group>noise</group>
  </rule>

  <!-- .psql_history modified 무시 -->
  <!-- 이유: psql 사용 시 명령어 히스토리 파일이 변경됨 -->
  <!-- 삭제(553)는 탐지 유지 — 히스토리 삭제는 흔적 제거 의심 -->
  <rule id="100056" level="0">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">\.psql_history$</field>
    <description>psql 히스토리 정상 변경 — 무시</description>
    <group>noise</group>
  </rule>


  <!-- 이유: 매분 실행되는 크론이 syslog에 기록되어 2502로 잡힘 -->
  <!-- onprem CRON 노이즈 억제 - 수정 260612 김강환 -->
  <rule id="100057" level="0">
    <if_sid>2502</if_sid>
    <program_name>CRON</program_name>
    <description>CRON 정상 동작 — 무시</description>
    <group>noise</group>
  </rule>
  <!-- 배포 백업 디렉토리 FIM 억제 - 추가 260612 김강환 -->
  <rule id="100063" level="0">
    <if_sid>554,553,550</if_sid>
    <field name="file" type="pcre2">\.bak\.</field>
    <description>배포 백업 디렉토리 파일 변경 — 무시</description>
    <group>noise</group>
  </rule>


  <!-- 배포 임시 파일 FIM 억제 추가 260618 김강환 -->
  <rule id="100064" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">\.tmp\.</field>
    <description>배포 임시 파일 변경 — 무시</description>
    <group>noise,</group>
  </rule>


  <!-- UFW 비활성화 탐지 — 방화벽 우회 의심 추가 260618 김강환 -->
  <rule id="100068" level="15">
    <if_sid>100001</if_sid>
    <match>ufw disable|ufw stop|iptables -F|iptables --flush</match>
    <description>방화벽 비활성화 탐지 — 사용자: $(srcuser) 명령: $(command)</description>
    <group>onprem,firewall,defense_evasion,</group>
    <mitre><id>T1562.004</id></mitre>
  </rule>


  <!-- USB 데이터 유출 탐지 — sudo cp/mv to /media /mnt 추가 260618 김강환 -->
  <rule id="100069" level="15">
    <if_sid>100001</if_sid>
    <regex type="pcre2">COMMAND=.*\b(cp|mv)\b.*(/media|/mnt)</regex>
    <description>USB 데이터 유출 의심 — 사용자: $(srcuser) 명령: $(command)</description>
    <group>onprem,usb,data_exfiltration,</group>
    <mitre><id>T1052.001</id></mitre>
  </rule>


</group>

<!-- =========================================================
     EMR FastAPI 감사 로그 탐지
     수집 경로: /var/log/onprem-emr/audit.log
     FastAPI가 모든 API 요청을 JSON(fastapi_audit)으로 기록

     필드:
       event_type  : fastapi_audit (고정)
       action_type : LOGIN, READ, WRITE 등
       result_code : HTTP 상태코드
       source_ip   : 클라이언트 IP
       path        : 요청 URL 경로
       method      : HTTP 메서드

     ISMS-P 2.9.1 개인정보처리시스템 접근기록
     ========================================================= -->
<group name="onprem,fastapi,">

  <!-- 온프레미스 FastAPI 감사 로그 베이스 룰 - 수정 260612 김강환 -->
  <!-- 86600(Suricata) overwrite → source_type 없는 fastapi_audit는 온프레미스로 처리 -->
  <rule id="100600" level="0">
    <if_sid>86600</if_sid>
    <field name="event_type">^fastapi_audit$</field>
    <description>온프레미스 FastAPI 감사 로그 - $(action_type) $(method) $(path) $(result_code)</description>
    <group>onprem,fastapi,audit_archive,</group>
  </rule> 
  <!-- level=5 — 단일 실패는 기록만, 반복 시 100602로 escalate -->
  <!-- MITRE T1110 브루트포스 -->
  <rule id="100601" level="0">
    <if_sid>100600</if_sid>
    <field name="result_code">^401$|^403$</field>
    <description>온프레미스 FastAPI 로그인 실패 — IP: $(source_ip) 경로: $(path)</description>
    <group>onprem,fastapi,authentication_failed,</group>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- 온프레미스 FastAPI 정상 2xx 응답 억제 - 추가 260612 김강환 -->
  <rule id="100603" level="0">
    <if_sid>100600</if_sid>
    <field name="result_code">^2</field>
    <field name="method" negate="yes">^DELETE$</field>
    <field name="action_type" negate="yes" type="pcre2">^READ_PATIENT_DETAIL$|^READ_ENCOUNTERS$|^READ_ALLERGIES$|^READ_PRESCRIPTIONS$|^READ_SURGERY_HISTORIES$|^NURSE_DASHBOARD_VIEW$</field>
    <description>온프레미스 FastAPI 정상 응답 — 무시</description>
    <group>noise</group>
  </rule>

  <!-- 관리자 환자기록 조회 — 대량조회 카운터 - 추가 260615 김강환 -->
  <rule id="100604" level="0">
    <if_sid>100600</if_sid>
    <field name="action_type" type="pcre2">^READ_PATIENT_DETAIL$|^READ_ENCOUNTERS$|^READ_ALLERGIES$|^READ_PRESCRIPTIONS$|^READ_SURGERY_HISTORIES$|^NURSE_DASHBOARD_VIEW$</field>
    <description>관리자 환자기록 조회 — 사용자: $(user_id) 경로: $(path)</description>
    <group>onprem,fastapi,data_access,</group>
  </rule>

  <!-- 관리자 대량 환자기록 조회 — 인사이더 위협 의심 - 추가 260615 김강환 -->
  <rule id="100605" level="13" frequency="50" timeframe="60">
    <if_matched_sid>100604</if_matched_sid>
    <same_field>user_id</same_field>
    <description>관리자 대량 환자기록 조회 의심 — 사용자: $(user_id) 짧은 시간 내 다건 접근</description>
    <group>onprem,fastapi,data_exfiltration,insider_threat,</group>
    <mitre><id>T1213</id></mitre>
  </rule>


  <!-- FastAPI 500 에러 탐지 — 서버 오류/컨테이너 이상 의심 - 추가 260616 김강환 -->
  <rule id="100608" level="12">
    <if_sid>100600</if_sid>
    <field name="result_code">^5</field>
    <description>온프레미스 FastAPI 서버 오류 — $(action_type) IP: $(source_ip) 경로: $(path) 응답: $(result_code)</description>
    <group>onprem,fastapi,error,availability,</group>
  </rule>

</group>






<!-- =========================================================
     DB 감사 로그 탐지
     수집 경로: /var/log/deident/db_audit.log
     ISMS-P 2.9.1 개인정보처리시스템 접근기록
     ========================================================= -->
  <!-- =========================================================
       온프레미스 DB 감사로그 탐지 룰
       수집: /var/log/deident/db_audit.log
       ISMS-P 2.9.1 개인정보처리시스템 접근기록
       추가 260612 김강환
       ========================================================= -->
<group name="onprem,db_audit,">
  <!-- 베이스 룰 -->
  <rule id="100650" level="0">
    <decoded_as>json</decoded_as>
    <field name="audit_log_id">\.+</field>
    <description>온프레미스 DB 감사 로그 — $(action_type) 사용자: $(user_id) IP: $(source_ip)</description>
    <group>onprem,db_audit,</group>
  </rule>

  <!-- 무조건 탐지 — 밤낮 없이 -->
  <!-- DELETE/EXPORT/권한변경/계정관리 -->
  <rule id="100651" level="12">
    <if_sid>100650</if_sid>
    <field name="action_type">^DELETE$|^USER_DELETE$|^EXPORT$|^PERMISSION_UPDATE$|^ROLE_UPDATE$|^POLICY_UPDATE$|^USER_CREATE$|^USER_LOCK$|^LOCK_USER$|^USER_RESET_PW$|^USER_UPDATE$</field>
    <description>온프레미스 DB 위험 이벤트 — $(action_type) 사용자: $(user_id) IP: $(source_ip) 테이블: $(target_table)</description>
    <group>onprem,db_audit,critical,</group>
    <mitre><id>T1485</id></mitre>
  </rule>

  <!-- 평일 업무시간 외 탐지 (UTC 09:00~24:00 = KST 18:00~다음날 09:00) -->
  <rule id="100652" level="12">
    <if_sid>100650</if_sid>
    <field name="action_type">^READ_|^VIEW_|^SEARCH_|^SCHEDULE_VIEW$|^UPDATE$|^CREATE_|^USER_UPDATE$|^USER_CREATE$|^USER_RESET_PW$</field>
    <weekday>monday,tuesday,wednesday,thursday,friday</weekday>
    <time>9 am - 12 am</time>
    <description>평일 업무시간 외 온프레미스 DB 접근 — $(action_type) 사용자: $(user_id) IP: $(source_ip)</description>
    <group>onprem,db_audit,after_hours,</group>
    <mitre><id>T1530</id></mitre>
  </rule>

  <!-- 토요일 진료시간 외 탐지 (UTC 04:00~24:00 = KST 13:00~다음날 09:00) -->
  <rule id="100653" level="12">
    <if_sid>100650</if_sid>
    <field name="action_type">^READ_|^VIEW_|^SEARCH_|^SCHEDULE_VIEW$|^UPDATE$|^CREATE_|^USER_UPDATE$|^USER_CREATE$|^USER_RESET_PW$</field>
    <weekday>saturday</weekday>
    <time>4 am - 12 am</time>
    <description>토요일 진료시간 외 온프레미스 DB 접근 — $(action_type) 사용자: $(user_id) IP: $(source_ip)</description>
    <group>onprem,db_audit,after_hours,weekend,</group>
    <mitre><id>T1530</id></mitre>
  </rule>

  <!-- 일요일 전일 탐지 -->
  <rule id="100658" level="12">
    <if_sid>100650</if_sid>
    <field name="action_type">^READ_|^VIEW_|^SEARCH_|^SCHEDULE_VIEW$|^UPDATE$|^CREATE_|^USER_UPDATE$|^USER_CREATE$|^USER_RESET_PW$</field>
    <weekday>sunday</weekday>
    <description>일요일 온프레미스 DB 접근 — $(action_type) 사용자: $(user_id) IP: $(source_ip)</description>
    <group>onprem,db_audit,after_hours,weekend,</group>
    <mitre><id>T1530</id></mitre>
  </rule>

  <!-- 대량 조회 탐지 — 데이터 유출 의심 -->
  <rule id="100654" level="12" frequency="50" timeframe="60" ignore="60">
    <same_field>user_id</same_field>
    <if_matched_sid>100650</if_matched_sid>
    <field name="action_type">^READ_|^VIEW_|^SEARCH_</field>
    <description>온프레미스 DB 대량 조회 탐지 — 데이터 유출 의심 IP: $(source_ip)</description>
    <group>onprem,db_audit,data_exfiltration,</group>
    <mitre><id>T1530</id></mitre>
  </rule>

  <!-- 로그인 실패/계정 잠금 — 대시보드만 (Slack 안 보냄) -->
  <rule id="100656" level="0">
    <if_sid>100650</if_sid>
    <field name="action_type">^LOGIN_FAIL$|^ACCOUNT_LOCKED$</field>
    <description>온프레미스 DB 로그인 실패 — 사용자: $(user_id) IP: $(source_ip)</description>
    <group>onprem,db_audit,auth_failure,</group>
  </rule>

  <!-- 정상 동작 억제 -->
  <rule id="100655" level="0">
    <if_sid>100650</if_sid>
    <field name="action_type">^LOGIN$|^LOGOUT$|^TOKEN_REFRESH$|^LOGIN_SUCCESS$|^READ_ME$|^READ_MENUS$|^READ_PASSWORD_POLICY$|^VIEW_DASHBOARD$|^CHANGE_PASSWORD$|^PASSWORD_CHANGE$|^SESSION_STATUS$|^UNKNOWN$</field>
    <description>온프레미스 DB 정상 동작 — 무시</description>
    <group>noise</group>
  </rule>


</group>


<!-- =========================================================
     Ollama EMR 배치 로그 탐지
     수집 경로: /var/log/mzclinic/ollama/ollama-batch.log
     ISMS-P 2.9.1 로그관리
     ========================================================= -->
<group name="onprem,ollama,">

  <!-- Ollama 배치 로그 베이스 룰 - 260611 김강환 -->
  <rule id="100659" level="0">
    <if_sid>2502</if_sid>
    <field name="service">^ollama-emr-batch$</field>
    <description>Ollama EMR 배치 로그 - $(action_type)</description>
    <group>onprem,ollama,</group>
  </rule>

  <!-- Ollama 배치 실패 탐지 - 260611 김강환 -->
  <rule id="100660" level="12">
    <if_sid>100659</if_sid>
    <field name="level">^ERROR$</field>
    <description>Ollama EMR 배치 실패 — $(action_type)</description>
    <group>onprem,ollama,error,</group>
  </rule>

  <!-- 비식별화 API DELETE 탐지 — 무조건 위험 - 추가 260612 김강환 -->
  <rule id="100670" level="12">
    <if_sid>100600</if_sid>
    <field name="method">^DELETE$</field>
    <description>비식별화 API DELETE 요청 — 사용자: $(user_id) IP: $(source_ip) 경로: $(path)</description>
    <group>onprem,deident,critical,</group>
    <mitre><id>T1485</id></mitre>
  </rule>

  <!-- 비식별화 API 대량 요청 탐지 — 데이터 유출 의심 - 추가 260612 김강환 -->
  <rule id="100671" level="12" frequency="100" timeframe="60">
    <if_matched_sid>100600</if_matched_sid>
    <description>비식별화 API 대량 요청 탐지 — 데이터 유출 의심 IP: $(source_ip)</description>
    <group>onprem,deident,data_exfiltration,</group>
    <mitre><id>T1530</id></mitre>
  </rule>

  <!-- 비식별화 API 외부 IP 접근 시도 - 추가 260612 김강환 -->
  <rule id="100672" level="12">
    <if_sid>100600</if_sid>
    <field name="path" type="pcre2">^/deident|^/sync</field>
    <field name="source_ip" negate="yes" type="pcre2">^172\.30\.|^10\.</field>
    <description>비식별화 API 외부 IP 접근 시도 — IP: $(source_ip) 경로: $(path)</description>
    <group>onprem,deident,critical,</group>
    <mitre><id>T1190</id></mitre>
  </rule>


</group>