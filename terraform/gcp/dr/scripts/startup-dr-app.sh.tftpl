#!/bin/bash
# terraform/gcp/dr/scripts/startup-dr-app.sh.tftpl
set -euo pipefail

# ── Terraform 렌더링 값 ────────────────────────────────────────────────────────
PROJECT_ID="${project_id}"
CLOUD_SQL_IP="${cloud_sql_ip}"
DATABASE_NAME="${database_name}"
DATABASE_USER="${database_user}"
DB_PASSWORD_SECRET="${db_password_secret_name}"
JWT_SECRET_NAME="${jwt_secret_name}"
API_KEY_SECRET_NAME="${api_key_secret_name}"
ALLOWED_ORIGINS="${allowed_origins}"
APP_PORT="${app_port}"
ARTIFACT_BUCKET="${artifact_bucket}"
DR_APP_OBJECT="${dr_app_object}"
APP_DIR="/opt/gcp-dr-app"

# ── 아티팩트 다운로드 (코드만 — 패키지/venv는 이미지에 포함) ──────────────────
echo "[startup] GCS에서 앱 아티팩트 다운로드 중..."
gcloud storage cp "gs://$ARTIFACT_BUCKET/$DR_APP_OBJECT" /tmp/dr-app.zip
unzip -q -o /tmp/dr-app.zip -d "$APP_DIR"
rm /tmp/dr-app.zip




# ── Python runtime 확인: baked image venv 우선, 없을 때만 fallback ─────────────
echo "[startup] Python runtime 확인 중..."

BAKED_VENV="/opt/gcp-dr-venv"
RUNTIME_VENV="$APP_DIR/venv"

if [ -x "$BAKED_VENV/bin/python" ] && "$BAKED_VENV/bin/python" -c "import uvicorn" >/dev/null 2>&1; then
  echo "[startup] baked venv 사용: $BAKED_VENV"
elif [ -f "$APP_DIR/backend/requirements.txt" ]; then
  echo "[startup] baked venv 없음. runtime fallback venv 생성 중..."

  if ! python3 -m venv "$RUNTIME_VENV"; then
    apt-get update
    apt-get install -y python3-venv
    python3 -m venv "$RUNTIME_VENV"
  fi

  "$RUNTIME_VENV/bin/pip" install --upgrade pip
  "$RUNTIME_VENV/bin/pip" install -r "$APP_DIR/backend/requirements.txt"
else
  echo "[startup] ERROR: baked venv도 없고 requirements.txt도 없음"
  exit 1
fi

# ── Runtime secret runner 생성: secret 값을 디스크 .env에 저장하지 않음 ───────
echo "[startup] FastAPI runtime runner 생성 중..."

cat > /usr/local/bin/start-gcp-dr-app << RUNNER
#!/usr/bin/env bash
set -euo pipefail

PROJECT_ID="$PROJECT_ID"
CLOUD_SQL_IP="$CLOUD_SQL_IP"
DATABASE_NAME="$DATABASE_NAME"
DATABASE_USER="$DATABASE_USER"
DB_PASSWORD_SECRET="$DB_PASSWORD_SECRET"
JWT_SECRET_NAME="$JWT_SECRET_NAME"
API_KEY_SECRET_NAME="$API_KEY_SECRET_NAME"
ALLOWED_ORIGINS="$ALLOWED_ORIGINS"
APP_PORT="$APP_PORT"
APP_DIR="$APP_DIR"
COOKIE_SECURE="${cookie_secure}"

DB_PASSWORD=\$(gcloud secrets versions access latest \
  --project="\$PROJECT_ID" --secret="\$DB_PASSWORD_SECRET")

JWT_SECRET_VALUE=\$(gcloud secrets versions access latest \
  --project="\$PROJECT_ID" --secret="\$JWT_SECRET_NAME")

API_KEY_VALUE=\$(gcloud secrets versions access latest \
  --project="\$PROJECT_ID" --secret="\$API_KEY_SECRET_NAME")

DATABASE_URL=\$(python3 - "\$DATABASE_USER" "\$DB_PASSWORD" "\$CLOUD_SQL_IP" "\$DATABASE_NAME" <<'PY'
import sys
from urllib.parse import quote

user = quote(sys.argv[1], safe="")
password = quote(sys.argv[2], safe="")
host = sys.argv[3]
name = sys.argv[4]

print(f"postgresql+psycopg2://{user}:{password}@{host}:5432/{name}")
PY
)

cd "\$APP_DIR/backend"

BAKED_VENV="/opt/gcp-dr-venv"

if [ -x "\$BAKED_VENV/bin/python" ] && "\$BAKED_VENV/bin/python" -c "import uvicorn" >/dev/null 2>&1; then
  PYTHON="\$BAKED_VENV/bin/python"
elif [ -x "\$APP_DIR/venv/bin/python" ]; then
  PYTHON="\$APP_DIR/venv/bin/python"
else
  PYTHON="\$(command -v python3)"
fi

exec env \
  DATABASE_URL="\$DATABASE_URL" \
  DATABASE_READ_URL="\$DATABASE_URL" \
  DB_SSLMODE="disable" \
  DB_MODE="cloud" \
  JWT_SECRET="\$JWT_SECRET_VALUE" \
  JWT_ALGORITHM="HS256" \
  API_KEY="\$API_KEY_VALUE" \
  COOKIE_SECURE="\$COOKIE_SECURE" \
  ALLOWED_ORIGINS="\$ALLOWED_ORIGINS" \
  ALLOWED_HOSTS="*" \
  TZ="Asia/Seoul" \
  PYTHONPATH="\$APP_DIR/backend" \
  "\$PYTHON" -m uvicorn main:app --host 127.0.0.1 --port "\$APP_PORT"
RUNNER

chmod 0750 /usr/local/bin/start-gcp-dr-app

# systemd override: 기존 서비스가 .env를 읽더라도 무시하고 runner로 실행
mkdir -p /etc/systemd/system/gcp-dr-app.service.d

cat > /etc/systemd/system/gcp-dr-app.service.d/override.conf <<'EOF'
[Service]
EnvironmentFile=
ExecStart=
ExecStart=/usr/local/bin/start-gcp-dr-app
Restart=always
RestartSec=5
EOF



# ── NGINX API Key header는 /run tmpfs에만 생성 ────────────────────────────────
echo "[startup] NGINX runtime API key header 생성 중..."

API_KEY_VALUE=$(gcloud secrets versions access latest \
  --project="$PROJECT_ID" --secret="$API_KEY_SECRET_NAME")

install -d -m 0700 /run/gcp-dr-app

python3 - "$API_KEY_VALUE" <<'PY'
import sys

api_key = sys.argv[1].replace("\\", "\\\\").replace('"', '\\"')

with open("/run/gcp-dr-app/api-key-header.conf", "w") as f:
    f.write(f'proxy_set_header X-API-Key "{api_key}";\n')
PY

chmod 0600 /run/gcp-dr-app/api-key-header.conf




# ── nginx 설정 ─────────────────────────────────────────────────────────────────
echo "[startup] nginx 설정 생성 중..."
python3 - "$APP_PORT" "$APP_DIR" <<'PY'
import sys

app_port = sys.argv[1]
app_dir  = sys.argv[2]

def proxy_location(path, upstream_path=None):
    upstream = upstream_path or path
    return f'''
    location {path} {{
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /run/gcp-dr-app/api-key-header.conf;
        proxy_pass http://127.0.0.1:{app_port}{upstream};
    }}'''

config = f'''server {{
    listen 80 default_server;
    server_name _;

    root {app_dir}/frontend;
    index index.html;

    location = /health {{
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /run/gcp-dr-app/api-key-header.conf;
        proxy_pass http://127.0.0.1:{app_port}/health;
    }}
{proxy_location("/auth/")}
{proxy_location("/staff/")}
{proxy_location("/api/staff/", "/staff/")}
{proxy_location("/portal/")}
{proxy_location("/api/portal/", "/portal/")}
{proxy_location("/patient/")}
{proxy_location("/api/patient/", "/patient/")}
{proxy_location("/emr/")}

    location / {{
        try_files $uri $uri/ /index.html;
    }}
}}
'''
with open("/etc/nginx/sites-available/gcp-dr-app", "w") as f:
    f.write(config)
PY

rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/gcp-dr-app \
       /etc/nginx/sites-enabled/gcp-dr-app

# ── 서비스 시작 ────────────────────────────────────────────────────────────────
echo "[startup] 서비스 시작 중..."
systemctl daemon-reload
systemctl enable --now gcp-dr-app
nginx -t
systemctl restart nginx

echo "[startup] 완료"
